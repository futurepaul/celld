{
  "name": "container-conformance",
  "main": "index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [
    {
      "class_name": "Conformance",
      "scheduling_policy": "durable_object",
      "images": {
        "base": { "dockerfile": "./Dockerfile" }
      }
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "CONFORMANCE", "class_name": "Conformance" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Conformance"] }]
}
