# fragment-celld.service's settings (/etc/fragment-celld/celld.env).

# The Worker listener. A front door (TLS, CF-Connecting-IP) sits in front.
CELLD_HOST=127.0.0.1
CELLD_PORT=8787

# The cell's wrangler config, a file in /opt/fragment/cell.
CELLD_CONFIG=wrangler.jsonc

# Containers run on the sandcastle engine, through its socket.
CELLD_CONTAINER_ENGINE=krun:/var/lib/sandcastle/engine.sock

# Fragment's settings for its cell, as its dev stack sets them
# (fragment's crates/devstack/src/celld.rs).
CELLD_FACET_MAX_BYTES=20971520
CELLD_DYNAMIC_LOCKDOWN=1
CELLD_MAX_CELL_REQUESTS=512
